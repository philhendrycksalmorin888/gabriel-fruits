# Copy these values into Streamlit Community Cloud > App settings > Secrets.
# Never commit a real secrets.toml file.

[supabase]
url = "https://YOUR_PROJECT.supabase.co"
key = "YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional authentication overrides. The project already contains a derived hash
# for the initial administrator password, so these are only needed if you want to
# replace it without editing source code.
[admin]
username = "admin"
# password_hash = "PBKDF2_HEX_HASH"
# password_salt = "YOUR_RANDOM_SALT"
# password_iterations = 310000
